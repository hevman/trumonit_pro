{
  "title": "TruMonit - Core Ops",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["TruMonit", "wids", "core"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue Backlog (wids ready)",
      "targets": [
        {
          "expr": "TruMonit_redis_queue_jobs_total{queue=\"wids\",state=\"ready\"}",
          "legendFormat": "ready"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scheduler Lag (p95 / max)",
      "targets": [
        {
          "expr": "TruMonit_scan_lag_seconds_p95",
          "legendFormat": "p95"
        },
        {
          "expr": "TruMonit_scan_lag_seconds_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue Wait (avg / p95)",
      "targets": [
        {
          "expr": "TruMonit_queue_wait_ms_last_1h_avg",
          "legendFormat": "avg"
        },
        {
          "expr": "TruMonit_queue_wait_ms_last_1h_p95",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Ratio (5m / 1h)",
      "targets": [
        {
          "expr": "TruMonit_error_rate_last_5m",
          "legendFormat": "5m"
        },
        {
          "expr": "TruMonit_error_rate_last_1h",
          "legendFormat": "1h"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Storage Growth",
      "targets": [
        {
          "expr": "TruMonit_storage_bytes_total",
          "legendFormat": "total bytes"
        },
        {
          "expr": "TruMonit_storage_bytes_last_24h",
          "legendFormat": "last 24h bytes"
        }
      ]
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  }
}
