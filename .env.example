# Generate two different strong secrets. No credential is committed.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
TRUMONIT_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TRUMONIT_LOCAL_PORT=3100

# Production defaults to disabled mail; self-registration is blocked until configured.
# For LOCAL DEVELOPMENT ONLY: TRUMONIT_ENV=development, TRUMONIT_MAIL_MODE=file
TRUMONIT_ENV=production
TRUMONIT_MAIL_MODE=disabled
TRUMONIT_PUBLIC_URL=
# For production SMTP_SSL only (requires valid HTTPS public URL and sender domain):
TRUMONIT_SMTP_HOST=
TRUMONIT_SMTP_PORT=465
TRUMONIT_SMTP_USER=
TRUMONIT_SMTP_PASSWORD=
TRUMONIT_MAIL_FROM=
